# Copy to .env for local Node development (npm run dev). Never commit .env.
# For Cloudflare Workers local dev, put the same keys in .dev.vars instead.

# Public origin of the site. Local dev uses the Vite dev server.
APP_ORIGIN=http://localhost:5173
# Comma-separated extra origins allowed to make state-changing requests (preview domains).
ALLOWED_ORIGINS=http://localhost:8787

# Comma-separated Discord user IDs with admin access. The seed admin is 100000000000000001.
ADMIN_DISCORD_IDS=100000000000000001

# DEVELOPMENT ONLY: enables "Dev login" (sign in as any user without Discord). Never in production.
DEV_LOGIN=true

# Discord OAuth2 (https://discord.com/developers/applications). Leave blank to disable Discord login.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Defaults to ${APP_ORIGIN}/api/auth/callback
# DISCORD_REDIRECT_URI=http://localhost:5173/api/auth/callback

# Optional automatic video verification. Without these, new submissions wait for a moderator.
YOUTUBE_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Optional settings
# DATABASE_PATH=data/eden-awards.sqlite
# PORT=8787
# HOST=127.0.0.1
# SESSION_TTL_DAYS=14
# TRUST_PROXY=false        # true only when the Node server is reachable solely through Cloudflare/a proxy
# SECURE_COOKIES=          # defaults to true when APP_ORIGIN is https
# RELEVANCE_KEYWORDS=daoc,dark age of camelot,eden,eden server
