{
  "name": "eden-awards",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Seasonal community video awards for Dark Age of Camelot's Eden server",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch --disable-warning=ExperimentalWarning --import tsx server/node.ts",
    "dev:web": "vite",
    "db:migrate": "tsx --disable-warning=ExperimentalWarning server/scripts/migrate.ts",
    "db:seed": "tsx --disable-warning=ExperimentalWarning server/scripts/seed.ts",
    "db:reset": "tsx --disable-warning=ExperimentalWarning server/scripts/seed.ts --reset",
    "db:seed-sql": "tsx --disable-warning=ExperimentalWarning server/scripts/seed.ts --sql > seed/seed.sql",
    "build": "npm run typecheck && vite build && node scripts/build-server.mjs",
    "start": "node --disable-warning=ExperimentalWarning dist/server/node.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "node e2e/smoke.mjs",
    "cf:dev": "npm run build && wrangler dev --port 8788 --local",
    "cf:deploy": "npm run build && wrangler deploy",
    "db:backup": "tsx --disable-warning=ExperimentalWarning server/scripts/backup.ts",
    "cf:migrate:local": "wrangler d1 migrations apply eden-awards --local",
    "cf:migrate:preview": "wrangler d1 migrations apply eden-awards-preview --remote --env preview",
    "cf:migrate:prod": "wrangler d1 migrations apply eden-awards --remote",
    "cf:deploy:preview": "npm run build && wrangler deploy --env preview"
  },
  "dependencies": {
    "@fontsource/alegreya-sans": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261024.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
